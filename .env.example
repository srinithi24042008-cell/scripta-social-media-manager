# ═══════════════════════════════════════════════════════════════
# Scripta — Social Media Management Platform
# Environment Configuration Template
# ═══════════════════════════════════════════════════════════════

PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# NOTE: Backend URL is hardcoded to https://sm.coptercode.co.in in production (see backend/routes/accounts.js and youtube.js)

# ── Authentication & Encryption ─────────────────────────────
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# ENCRYPTION_KEY=replace-with-another-long-random-secret-key

# ── Database ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/scripta

# ── AI Providers ─────────────────────────────────────────────
# Primary AI Provider: Gemini (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# ── Media Cloud Storage (Optional) ──────────────────────────
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-cloudinary-api-key
# CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── Social OAuth App Credentials ────────────────────────────
META_APP_ID=your-meta-app-id-here
META_APP_SECRET=your-meta-app-secret-here

# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# LINKEDIN_REDIRECT_URI=http://localhost:4000/api/accounts/oauth/callback/linkedin

# YOUTUBE_CLIENT_ID=your-youtube-client-id.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=your-youtube-client-secret

# ── Google OAuth (Sign in with Google) ──────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Frontend build arg — used by Vite at build time (docker-compose.dokploy.yml)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Email SMTP (Password Reset) ─────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
